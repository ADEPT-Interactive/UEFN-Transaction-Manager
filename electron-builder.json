{
  "appId": "AD3PTInteractive.UEFNEntitlementManager",
  "productName": "UEFN Transaction Manager",
  "executableName": "UEFN Transaction Manager",
  "artifactName": "UEFN-Transaction-Manager-${version}.${ext}",
  "asar": false,
  "compression": "normal",
  "npmRebuild": false,
  "buildDependenciesFromSource": false,
  "win": {
    "electronLanguages": ["en-US"],
    "target": [
      { "target": "nsis", "arch": ["x64"] }
    ],
    "icon": "electron/assets/uem-icon.ico"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "createDesktopShortcut": false,
    "createStartMenuShortcut": true,
    "shortcutName": "UEFN Transaction Manager",
    "runAfterFinish": true,
    "deleteAppDataOnUninstall": false,
    "artifactName": "UEFN-Transaction-Manager-Setup-${version}.${ext}"
  },
  "publish": [
    {
      "provider": "generic",
      "url": "https://updates.adeptinteractive.net/uem/stable/"
    }
  ]
}
