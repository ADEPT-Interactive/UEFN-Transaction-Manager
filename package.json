{
  "name": "uefn-entitlement-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade In-Island Transactions & Verse Entitlement Manager for UEFN creators by ADEPT Interactive",
  "main": "server/index.ts",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=cjs --outfile=dist/server.cjs",
    "preview": "vite preview",
    "server": "node dist/server.cjs",
    "start": "concurrently \"npm run server\" \"npm run dev\""
  },
  "keywords": [
    "uefn",
    "fortnite",
    "verse",
    "in-island-transactions",
    "entitlements",
    "adept-interactive"
  ],
  "author": "ADEPT Interactive",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "multer": "^1.4.5-lts.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
